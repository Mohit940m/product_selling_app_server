PORT=4000
MONGO_URI="your_mongo_db_connection_string_here"
JWT_SECRET="your_jwt_secret_here"

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME="your_cloud_name_here"
CLOUDINARY_API_KEY="your_api_key_here"
CLOUDINARY_API_SECRET="your_api_secret_here"

#Redis
# Set to "true" to run with Redis caching. Anything else (or unset) runs the API without Redis.
REDIS_ENABLED="false"
REDIS_URL="your_redis_url_here"

#Razorpay Configuration
RAZORPAY_KEY_ID = "your_razorpay_key_id_here"
RAZORPAY_KEY_SECRET = "your_razorpay_key_secret_here"
RAZORPAY_WEBHOOK_SECRET = "your_razorpay_webhook_secret_here"

# MCP Server (src/mcp) — thin HTTP wrapper around this API.
# Base URL of the running API (defaults to http://localhost:${PORT}).
MCP_API_BASE_URL="http://localhost:4000"
# Pre-issued buyer JWT used by buyer/public tools (optional).
MCP_API_TOKEN="your_buyer_jwt_here"
# Pre-issued seller JWT used by seller tools (optional).
MCP_SELLER_API_TOKEN="your_seller_jwt_here"