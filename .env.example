PORT=4000
# Prefer the non-SRV form (mongodb://host1,host2,host3/db?ssl=true&replicaSet=...&authSource=admin)
# if your network's SRV DNS lookups are unreliable; the mongodb+srv:// form also works.
MONGO_URI="your_mongo_db_connection_string_here"
JWT_SECRET="your_jwt_secret_here"

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME="your_cloud_name_here"
CLOUDINARY_API_KEY="your_api_key_here"
CLOUDINARY_API_SECRET="your_api_secret_here"

#Redis
# Set to "true" to run with Redis caching. Anything else (or unset) runs the API without Redis.
REDIS_ENABLED="false"
REDIS_URL="your_redis_url_here"

#Razorpay Configuration
RAZORPAY_KEY_ID = "your_razorpay_key_id_here"
RAZORPAY_KEY_SECRET = "your_razorpay_key_secret_here"
# Not currently read anywhere in src/ — there is no Razorpay webhook
# route/handler implemented yet. Payment confirmation today relies
# entirely on the client calling POST /order/verify-payment after the
# Razorpay checkout modal reports success; if the browser closes or the
# network drops between Razorpay capturing payment and that call
# completing, the order never gets marked PAID even though the money
# was taken, since nothing server-side is listening for Razorpay's own
# payment.captured event as a fallback. Implementing a real webhook
# handler (POST route with express.raw() body parsing — Razorpay's
# signature check needs the raw body, which the global express.json()
# middleware in server.ts would otherwise already have consumed —
# verifying x-razorpay-signature against this secret, and idempotently
# reconciling order/payment state) is a real feature to build, not a
# one-line fix, so it's left as a known gap rather than attempted here.
RAZORPAY_WEBHOOK_SECRET = "your_razorpay_webhook_secret_here"